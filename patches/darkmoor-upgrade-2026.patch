+// Extract native .so files from the `natives` configuration into the per-ABI
+// jniLibs folders so they get packaged into the APK. Replaces the old
+// `tasks.withType(PackageApplication).jniFolders` API removed in AGP 8.
+task copyAndroidNatives {
+    doFirst {
+        [ 'armeabi-v7a', 'arm64-v8a', 'x86', 'x86_64' ].each { abi ->
+            file("libs/${abi}").mkdirs()
+        }
+        configurations.natives.files.each { jar ->
+            def abi = jar.name.find(/natives-(armeabi-v7a|arm64-v8a|x86|x86_64)\.jar/) { _, a -> a }
+            if (abi) {
+                copy {
+                    from zipTree(jar)
+                    into "libs/${abi}"
+                    include '*.so'
+                }
             }
         }
     }
 }
 
