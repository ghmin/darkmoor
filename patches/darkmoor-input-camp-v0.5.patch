+        public static final int MINIMAP_WIDTH = 260;
+        /** minimap 显示区域高度（像素） */
+        public static final int MINIMAP_HEIGHT = 260;
+        /** minimap 左下角 X（stage 坐标）— 放在原 nav 按钮区域，避开主视角 */
