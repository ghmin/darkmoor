+                        heroInterfaceGroup.setVisible(false);
+                        inventoryGroup.setVisible(false);
+                        statisticsGroup.setVisible(true);
+                        navControlsGroup.setVisible(false);
+                        statisticsGroup.update();
+                }
+
+                navControlsGroup.update();
+        }
