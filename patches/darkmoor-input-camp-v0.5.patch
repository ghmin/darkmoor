+
+        @Override
+        public void update() {
+                if (team == null || team.getMaze() == null)
+                        return;
+
+                // 根据 Settings 决定可见性
+                Settings settings = Settings.getLastLoadedInstance();
+                setVisible(settings == null || settings.isShowMinimap());
+                if (!isVisible())
+                        return;
+
+                redraw();
+        }
