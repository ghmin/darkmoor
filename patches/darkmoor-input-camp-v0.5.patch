+        private static final Color COLOR_MONSTER = new Color(1f, 0.33f, 0.33f, 1f);
+        private static final Color COLOR_ITEM = new Color(1f, 0.65f, 0f, 1f);
+        private static final Color COLOR_TEAM = new Color(0.4f, 0.41f, 0.71f, 1f);
