+        /** v0.5 新增：本窗口自己的 ScreenButton 列表。
+         * 子类（MainWindow 等）用 screenButtons.add(button) 注册按钮，
+         * BaseWindow.update(delta) 会轮询鼠标点击并调用 onSelectEntry()。 */
+        protected ArrayList<ScreenButton> screenButtons;
