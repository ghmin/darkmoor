+        }
+
+        public void stopMusic() {
+                if (theme != null && theme.isPlaying())
+                        theme.stop();
+        }
+
+        public void resumeMusic() {
+                if (theme != null && !theme.isPlaying() && Settings.getLastLoadedInstance().isMusic())
+                        theme.play();
+        }
