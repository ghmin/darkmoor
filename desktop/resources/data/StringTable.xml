<bank>
	<stringtable name="Intro">
		<default name="English" />
		<language name="English">
			<string id="1">We, the Lords of Waterdeep, have gathered<br />to purge our city of an ancient evil,</string>
			<string id="2">Give call to the heroes of the land, and<br />let us choose our champions.</string>
			<string id="3">Master....</string>
			<string id="4">They think they have found a solution.</string>
			<string id="5">We commission you to find the nature of<br />this evil, and destroy it if you are able.</string>
			<string id="6">Prepare for the dangerous journey.</string>
			<string id="7">Begin your search below the city.</string>
			<string id="8">We have them.</string>
			<string id="9">Their fate is sealed.</string>
		</language>
		<language name="Francais">
			<string id="1">Nous, les Lords de WaterDeep, sommes<br />reunis pour purger notre ville d'un mal.</string>
			<string id="2">Donnez appel aux heros de la terre, et<br />laissez-nous choisir nos champions.</string>
			<string id="3">Maitre...</string>
			<string id="4">Ils pensent avoir trouve une solution.</string>
			<string id="5">Nous vous chargeons de trouver la nature de<br />ce mal, et d&#xE9;truisez-le si vous en &#xEA;tes capable.</string>
			<string id="6">Pr&#xE9;parez vous pour ce dangeureux voyage.</string>
			<string id="7">Commencez votre recherche sous la ville.</string>
			<string id="8">Nous les avons.</string>
			<string id="9">Leur sort est scell&#xE9;.</string>
		</language>
		<language name="Chinese">
			<string id="1">我们，深水城的诸位领主齐聚一堂，<br />只为涤荡城中潜藏的远古邪祟。</string>
			<string id="2">传召这片大地上的英雄，<br />让我们挑选出自己的勇士。</string>
			<string id="3">主人……</string>
			<string id="4">他们以为已经找到了对策。</string>
			<string id="5">我们委派你去查明这股邪恶的根源，<br />若力所能及，便将其彻底摧毁。</string>
			<string id="6">准备好踏上这凶险的旅程。</string>
			<string id="7">从城市地底开始你的搜寻。</string>
			<string id="8">我们抓到他们了。</string>
			<string id="9">他们的命运已被封定。</string>
		</language>
	</stringtable>
